{
  "manifest_version": 2,
  "name": "TB Journal",
  "version": "0.1.0",
  "description": "VJOURNAL-Verwaltung auf Basis der Thunderbird-Kalender.",
  "applications": {
    "gecko": {
      "id": "tb-journal@example.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "browser_action": {
    "default_title": "TB Journal öffnen",
    "default_label": "TB Journal",
    "allowed_spaces": [],
    "default_windows": [
      "normal"
    ]
  },
  "experiment_apis": {
    "tbJournalCalendar": {
      "schema": "experiments/tbJournalCalendar/schema/api.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "script": "experiments/tbJournalCalendar/parent/implementation.js",
        "paths": [
          [
            "tbJournalCalendar"
          ]
        ]
      }
    }
  },
  "commands": {
    "open-journal": {
      "suggested_key": {
        "default": "Ctrl+Alt+J"
      },
      "description": "TB Journal öffnen"
    }
  },
  "permissions": [
    "tabs",
    "<all_urls>"
  ]
}
